<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:cardUseCompatPadding="true"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="18dp">

        <!-- Circle Icon -->
        <TextView
            android:id="@+id/iconText"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="CA"
            android:textStyle="bold"
            android:textColor="#0E6F66"
            android:textSize="15sp"
            android:background="@drawable/icon_circle_green"/>

        <!-- Center Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment #123456"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="#1F1F1F"/>

            <TextView
                android:id="@+id/locationDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-03-19 22:03"
                android:textSize="13sp"
                android:textColor="#8A8A8A"
                android:layout_marginTop="3dp"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PAID"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:background="@drawable/status_completed"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Right Side -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/amountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 2,459.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0E6F66"/>

            <TextView
                android:id="@+id/ticketCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ref: 3200325"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>